{
  "name": "rumbo",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:client": "pnpm --filter @rumbo/client run dev",
    "dev:server": "pnpm --filter @rumbo/server run dev",
    "build": "pnpm -r run build",
    "db:migrate": "pnpm --filter @rumbo/server run db:migrate",
    "db:seed": "pnpm --filter @rumbo/server run db:seed",
    "db:studio": "pnpm --filter @rumbo/server run db:studio"
  },
  "pnpm": {}
}
